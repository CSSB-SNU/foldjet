# B200 = host `b200` (8 x B200 sm_100a, shared account, NO Slurm; GPUs 0-3 are ours, a colleague trains on 4-7). Four lanes, one per GPU:
# the lane driver (common/b200_lane.sh) sets CUDA_VISIBLE_DEVICES; this file never does. Sourced by the per-card scripts; every value can be overridden.
# Python: $B200_P/ffenv (venv layered on the engine team's read-only pixi env eng-2511, torch 2.13.0+cu129 / triton 3.7.1 / cuequivariance 0.12 + the FoldForge deps).
# Engine under test: the v3.0.7 source tree (ffc4204cd) in front of everything through PYTHONPATH; the sm100a kernels come from the prebuilt JIT cache.
export CARD=b200
export W=${W:-/NHNHOME/WORKSPACE/26mohw002_A/psk6950}
export B200_P=${B200_P:-$W/paper-b200}
: "${FF_REPO:=$B200_P/ff/foldforge}"
: "${FF_ENV:=$B200_P/ffenv}"
export FF_REPO FF_ENV
export ENGINE_ROOT=${ENGINE_ROOT:-$B200_P/engine307}
export PATH=$FF_ENV/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
export LD_LIBRARY_PATH=$W/eng-2511/.pixi/envs/default/lib
export PYTHONNOUSERSITE=1
export FOLDFORGE_HOME=${FOLDFORGE_HOME:-$B200_P/ff/home}
export FOLDFORGE_5I28_FASTA=$FF_REPO/tests/release_references/inputs/5i28/A.fasta
export FOLDFORGE_5I28_MSA_DB=${FOLDFORGE_5I28_MSA_DB:-$B200_P/ff/lmdb_5i28/a3m_16k.lmdb}
export FOLDFORGE_5I28_TEMPLATE_DB=${FOLDFORGE_5I28_TEMPLATE_DB:-$B200_P/ff/lmdb_5i28/template.lmdb}
export FB_ROOT=${FB_ROOT:-$B200_P/ff/data/foldbench}      # data.yaml paths rewritten to this absolute location (sed on the copy)
export PAPER_OUT=${PAPER_OUT:-$B200_P/ff/paper}
export TMPDIR=$B200_P/tmp XDG_CACHE_HOME=$B200_P/cache MPLCONFIGDIR=$B200_P/cache/matplotlib
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$XDG_CACHE_HOME/triton} TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$XDG_CACHE_HOME/inductor} TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$XDG_CACHE_HOME/torch_ext}
export MINIWORLD_ENGINE_JIT_ROOT=${MINIWORLD_ENGINE_JIT_ROOT:-}   # unset on purpose: engine_jit_root() = $XDG_CACHE_HOME/miniworld_engine_jit (the sm100 prebuild, 840 kernels)
unset MINIWORLD_ENGINE_JIT_ROOT
export CUDA_HOME=${CUDA_HOME:-/usr/local/cuda} CUDA_DEVICE_ORDER=PCI_BUS_ID NVCC_PREPEND_FLAGS="-ccbin /usr/bin/g++"
export CUTLASS_PATH=${CUTLASS_PATH:-$W/refs/cutlass} CUTLASS_DIR=${CUTLASS_DIR:-$W/refs/cutlass}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8} PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1 MAX_JOBS=4 TORCHINDUCTOR_COMPILE_THREADS=4
export MINIWORLD_ANTHROPIC_ROOT=${MINIWORLD_ANTHROPIC_ROOT:-$W/eng-2511/third_party/anthropic/upstream}
export PYTHONPATH=$ENGINE_ROOT/src:$FF_REPO/src   # the engine under test first, then the checkout under test
[ -n "${ENGINE_SRC:-}" ] && export PYTHONPATH=$ENGINE_SRC:$PYTHONPATH
mkdir -p "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR" "$TORCH_EXTENSIONS_DIR" "$TMPDIR" "$PAPER_OUT/logs"
