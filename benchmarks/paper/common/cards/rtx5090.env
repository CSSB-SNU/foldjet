# RTX 5090 = cssb-rtx (one GPU, shared by every agent: run under ~/mwe/gpu.sh SECONDS cmd (flock + 16 GB RAM slice); nvcc <= 4 jobs; never build and time at once).
export CARD=rtx5090
: "${FF_REPO:=$HOME/ff/FoldJet}"
: "${FF_ENV:=$FF_REPO/.pixi/envs/default}"
export FF_REPO FF_ENV
export PATH=$FF_ENV/bin:$PATH LD_LIBRARY_PATH=$FF_ENV/lib:${LD_LIBRARY_PATH:-}
export FOLDJET_HOME=${FOLDJET_HOME:-$HOME/ff/home}
export FOLDJET_5I28_FASTA=$FF_REPO/tests/release_references/inputs/5i28/A.fasta
export FOLDJET_5I28_MSA_DB=${FOLDJET_5I28_MSA_DB:-$FF_REPO/benchmarks/5i28_data/a3m_16k.lmdb}       # in the repository (key P0113359)
export FOLDJET_5I28_TEMPLATE_DB=${FOLDJET_5I28_TEMPLATE_DB:-$FF_REPO/benchmarks/5i28_data/template.lmdb}
export FB_ROOT=${FB_ROOT:-$HOME/data/foldbench}
export PAPER_OUT=${PAPER_OUT:-$HOME/foldforge-scratch/paper}
C=$PAPER_OUT/cache/$CARD
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$C/triton} TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$C/inductor} TORCH_EXTENSIONS_DIR=${TORCH_EXTENSIONS_DIR:-$C/torch_extensions}
# engine JIT cache: the pooled warm one (the rc-3.0.6 / 3.0.5 sm120 builds are there)
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export CUDA_HOME=${CUDA_HOME:-/usr/local/cuda-12.8} PATH=${CUDA_HOME:-/usr/local/cuda-12.8}/bin:$PATH
export FOLDJET_ENGINE_HEADER_CACHE=${FOLDJET_ENGINE_HEADER_CACHE:-$HOME/.cache/miniworld_engine_headers} FOLDJET_ENGINE_BUILD_ARCH=sm120 MAX_JOBS=4
export TORCHINDUCTOR_COMPILE_THREADS=4 OMP_NUM_THREADS=${OMP_NUM_THREADS:-16} PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1 CUDA_VISIBLE_DEVICES=0
export FOLDJET_ENGINE_ANTHROPIC_ROOT=${FOLDJET_ENGINE_ANTHROPIC_ROOT:-$HOME/ff/anthropic_upstream}
export PYTHONPATH=$FF_REPO/src   # the checkout under test (the environment's editable install may point at another checkout)
[ -n "${ENGINE_SRC:-}" ] && export PYTHONPATH=$ENGINE_SRC:$PYTHONPATH
mkdir -p "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR" "$TORCH_EXTENSIONS_DIR"
