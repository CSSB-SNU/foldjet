# A100 = cssb3 (own home and Slurm: partition A100, no account / qos). Sourced by the per-card scripts; every value can be overridden.
export CARD=a100
: "${FF_REPO:=$HOME/FoldJet}"
: "${FF_ENV:=$FF_REPO/.pixi/envs/default}"
E2=${ENGINE_BUILD_ENV:-$HOME/practice/miniworld-engine/.pixi/envs/default}   # nvcc for the engine's sm80 JIT
export FF_REPO FF_ENV
export PATH=$FF_ENV/bin:/usr/bin:/bin:$E2/bin LD_LIBRARY_PATH=$FF_ENV/lib CONDA_PREFIX=$FF_ENV CUDA_HOME=${CUDA_HOME:-$E2}
[ -d $HOME/.cache/foldjet ] || [ ! -d $HOME/.cache/foldforge ] && _FJH=$HOME/.cache/foldjet || _FJH=$HOME/.cache/foldforge   # the pre-rename home keeps being used while the new one does not exist
export FOLDJET_HOME=${FOLDJET_HOME:-$_FJH}
export FOLDJET_5I28_FASTA=$FF_REPO/tests/release_references/inputs/5i28/A.fasta
export FOLDJET_5I28_MSA_DB=${FOLDJET_5I28_MSA_DB:-$FF_REPO/benchmarks/5i28_data/a3m_16k.lmdb}       # in the repository (key P0113359)
export FOLDJET_5I28_TEMPLATE_DB=${FOLDJET_5I28_TEMPLATE_DB:-$FF_REPO/benchmarks/5i28_data/template.lmdb}
export FB_ROOT=${FB_ROOT:-$HOME/data/foldbench}
export PAPER_OUT=${PAPER_OUT:-$HOME/foldforge-scratch/paper}
C=$PAPER_OUT/cache/$CARD
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$C/triton} TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$C/inductor}
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-16} PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1
if [ -x /opt/ohpc/pub/compiler/gcc/12.4.0/bin/g++ ]; then export CC=/opt/ohpc/pub/compiler/gcc/12.4.0/bin/gcc CXX=/opt/ohpc/pub/compiler/gcc/12.4.0/bin/g++; fi
export FOLDJET_ENGINE_ANTHROPIC_ROOT=${FOLDJET_ENGINE_ANTHROPIC_ROOT:-$HOME/practice/miniworld-engine/third_party/anthropic/upstream}
export KIT_BENCH=${KIT_BENCH:-$HOME/practice/bench5i28_a100_kits}
export PYTHONPATH=$FF_REPO/src   # the checkout under test (the environment's editable install may point at another checkout)
[ -n "${ENGINE_SRC:-}" ] && export PYTHONPATH=$ENGINE_SRC:$PYTHONPATH
mkdir -p "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR"
