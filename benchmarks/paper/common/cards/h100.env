# H100 cluster (node01/node02, Slurm: -A cssb --qos=cssb_h100 -p h100). Sourced by the per-card scripts; every value can be overridden from the caller's environment.
# Never `pixi run` on the shared environment: the env's python is called directly.
export CARD=h100
: "${FF_REPO:=$HOME/FoldForge}"          # the FoldForge checkout under test (one commit for the whole campaign)
: "${FF_ENV:=$FF_REPO/.pixi/envs/default}"                   # its environment (pinned engine inside)
export FF_REPO FF_ENV
export PATH=$FF_ENV/bin:/usr/bin:/bin LD_LIBRARY_PATH=$FF_ENV/lib CONDA_PREFIX=$FF_ENV
export FOLDFORGE_HOME=${FOLDFORGE_HOME:-$HOME/.cache/foldforge}
export FOLDFORGE_5I28_FASTA=$FF_REPO/tests/release_references/inputs/5i28/A.fasta
export FOLDFORGE_5I28_MSA_DB=${FOLDFORGE_5I28_MSA_DB:-$FF_REPO/benchmarks/5i28_data/a3m_16k.lmdb}       # in the repository (key P0113359)
export FOLDFORGE_5I28_TEMPLATE_DB=${FOLDFORGE_5I28_TEMPLATE_DB:-$FF_REPO/benchmarks/5i28_data/template.lmdb}
export FB_ROOT=${FB_ROOT:-$HOME/data/foldbench}              # FoldBench inputs / msa / template / ground_truth / upstream
export PAPER_OUT=${PAPER_OUT:-$HOME/foldforge-scratch/paper}  # run outputs (never in the repository)
C=$PAPER_OUT/cache/$CARD
export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-$C/triton} TORCHINDUCTOR_CACHE_DIR=${TORCHINDUCTOR_CACHE_DIR:-$C/inductor}
# engine JIT extensions: the shared warm cache (a campaign must not start from an empty one: no first-call compile inside a timed run)
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-16} PYTHONUNBUFFERED=1 PYTHONFAULTHANDLER=1
if [ -x /opt/ohpc/pub/compiler/gcc/12.4.0/bin/g++ ]; then export CC=/opt/ohpc/pub/compiler/gcc/12.4.0/bin/gcc CXX=/opt/ohpc/pub/compiler/gcc/12.4.0/bin/g++; fi
export CUTLASS_PATH=${CUTLASS_PATH:-$HOME/MiniWorld/runs/anthropic_adoption_20260919/cutlass-4.2} MATHDX_HOME=${MATHDX_HOME:-$HOME/mathdx_dl/extracted/nvidia/mathdx}
export CUDA_HOME=${CUDA_HOME:-/usr/local/cuda-12.9}
# Anthropic kernels for the `anthropic` arm (the engine's connection; an external baseline)
export MINIWORLD_ANTHROPIC_ROOT=${MINIWORLD_ANTHROPIC_ROOT:-$HOME/miniworld-engine/third_party/anthropic/upstream}
# Anthropic 5I28 kit harness (F3 / F9 kit side): the 2026-11-18 steady harness
export KIT_BENCH=${KIT_BENCH:-$HOME/miniworld-engine-scratch/bench5i28_1118_steady}
# the engine under test: a release-candidate source tree shadows the installed engine (unset once the release is pinned)
export PYTHONPATH=$FF_REPO/src   # the checkout under test (the environment's editable install may point at another checkout)
[ -n "${ENGINE_SRC:-}" ] && export PYTHONPATH=$ENGINE_SRC:$PYTHONPATH
mkdir -p "$TRITON_CACHE_DIR" "$TORCHINDUCTOR_CACHE_DIR"
